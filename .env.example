#  reservas-db (MySQL)
# Se aplican SOLO en la primera inicialización del volumen (datadir vacío).
MYSQL_ROOT_PASSWORD=cambiar_root_pass    # contraseña de root; la usa el healthcheck (mysqladmin)
MYSQL_DATABASE=reservasdb                # base que se crea al inicializar
MYSQL_USER=reservas_user                 # usuario de la aplicación
MYSQL_PASSWORD=cambiar_pass              # contraseña del usuario de la aplicación

# reservas-api (Node/Express)
# La API se conecta a la base por nombre de red, con el usuario de la app.
DB_HOST=reservas-db                      # nombre del servicio de la base en la red
DB_USER=reservas_user                    # mismo usuario que MYSQL_USER
DB_PASSWORD=cambiar_pass                 # misma contraseña que MYSQL_PASSWORD
DB_NAME=reservasdb                       # misma base que MYSQL_DATABASE

# ─── reservas-frontend (nginx) ───
# No consume secretos; resuelve la API por nombre de red (definido en su imagen).
